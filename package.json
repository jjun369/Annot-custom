{
  "name": "pagedock",
  "version": "0.3.0",
  "description": "A local-first PDF study workspace with optional AI assistance.",
  "private": true,
  "license": "Apache-2.0",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "dev:desktop": "concurrently -k -s first \"next dev\" \"wait-on http://127.0.0.1:3000 && electron . --dev\"",
    "build": "next build",
    "assets:icons": "node scripts/build-icons.mjs",
    "build:desktop": "npm run build && npm run assets:icons && electron-builder --win nsis",
    "verify:release": "npm run lint && tsc --noEmit --incremental false && npm run build && npm run assets:icons",
    "release:desktop": "npm run build && npm run assets:icons && electron-builder --win nsis --publish always",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "jszip": "^3.10.1",
    "katex": "^0.16.42",
    "lucide-react": "^1.6.0",
    "next": "^16.2.12",
    "pdfjs-dist": "^5.5.207",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "react-pdf": "^10.4.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "^16.2.12",
    "png-to-ico": "^3.0.2",
    "sharp": "0.35.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.1.0"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
}
